*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text

# The source-release launchers are executed by sh, and a CRLF line ending is a
# syntax error there ("\r: command not found") rather than something it tolerates.
# Git's default is to leave .sh alone on Windows checkouts, so say it.
*.sh text eol=lf
*.command text eol=lf
